// Coobee AI 主配置文件模板
// 模型供应商配置请查看 providers.json5
// API Key 建议存放在 secrets.json5 中
{
  models: {
    defaults: {
      model: {
        primary: 'dashscope/qwen-plus-latest',
      },
      embedding: {
        primary: 'dashscope/text-embedding-v4',
      },
      thinkingLevel: 'medium',
    },
  },
  ui: {
    theme: 'auto',
    language: 'zh-CN',
    soundEffects: true,
  },
  logging: {
    level: 'info',
    file: true,
  },
  security: {
    sandbox: {
      mode: 'path-only',
    },
    approvals: {
      exec: 'auto',
    },
  },
}
# Coobee Agent - 生产环境配置
# 此文件中的变量会在打包后的生产环境中加载

# ==================== 日志配置 ====================
# 日志级别: error | warn | info | debug
VITE_LOG_LEVEL=info

# 日志文件最大大小 (bytes)
VITE_LOG_MAX_SIZE=10485760

# ==================== 调试模式 ====================
# 是否启用调试模式
VITE_DEBUG=false

# 是否自动打开开发者工具
VITE_OPEN_DEVTOOLS=false

# ==================== 服务器配置 ====================
# HTTP + WebSocket 服务器端口
VITE_SERVER_PORT=8765

# 服务器绑定地址（生产环境建议仅本机访问）
VITE_SERVER_HOST=127.0.0.1

# ==================== 模型配置 ====================
# 模型存储目录（可选，不设置则使用默认路径 ~/.coobee-agent/models）
# VITE_MODEL_DIR=/path/to/models

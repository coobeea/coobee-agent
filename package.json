{
  "name": "coobee-agent",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "generate:icons": "node scripts/generate-icons.js",
    "start": "electron-vite preview",
    "dev": "cross-env VITE_DEV_MODE=true electron-vite dev --watch",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps && node scripts/download-uv.mjs",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@duckdb/node-api": "1.5.5-r.2",
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^15.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.13.5",
    "@openai/agents-extensions": "0.13.5",
    "@tiptap/core": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@tiptap/vue-3": "^3.29.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "cron-parser": "^5.6.2",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "electron-log": "^5.4.4",
    "electron-store": "11.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "events": "^3.3.0",
    "glob": "^13.0.6",
    "highlight.js": "10.7.3",
    "jiti": "^2.7.0",
    "json5": "^2.2.3",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.0",
    "markdown-it-highlightjs": "^4.3.0",
    "minimatch": "^10.2.5",
    "mitt": "^3.0.1",
    "mkdirp": "^3.0.1",
    "monaco-editor": "^0.56.0",
    "multer": "^2.2.0",
    "nanoid": "^6.0.0",
    "node-cron": "^4.6.0",
    "openai": "^6.49.0",
    "pdfjs-dist": "^6.1.200",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "proper-lockfile": "^4.1.2",
    "tokenx": "^1.5.0",
    "vue-router": "^5.2.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@iconify-json/carbon": "^1.2.24",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@sinclair/typebox": "^0.34.52",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/koa__multer": "^2.0.8",
    "@types/lodash": "^4.17.24",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "adm-zip": "^0.6.0",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "lint-staged": "^17.2.0",
    "node-fetch": "^3.3.2",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.ts": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.1.0"
  }
}
